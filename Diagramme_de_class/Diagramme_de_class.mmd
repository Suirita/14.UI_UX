classDiagram
  class Branch {
    + int id
    + string title
    + date createdAt
    + date udatedAt
  }

  class Question {
    + int id
    + string title
    + string description
    + date createdAt
    + date udatedAt
  }

  class Student {
    + int id
    + string firstName
    + string lastName
    + date createdAt
    + date udatedAt
  }

  class Answer {
    + int id
    + int score
    + date createdAt
    + date udatedAt
  }

  Branch "1" -- "*" Question
  Answer "*" -- "1" Question
  Answer "*" -- "1" Student
